{
  "name": "@dsh-nacos/ai",
  "version": "0.2.0",
  "description": "DeepSeek Harness integration for Nacos AI AgentSpecs and Skills",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "check": "node --check src/core.js && node --check src/index.js && node --check src/client.js",
    "test": "node --test test/core.test.mjs",
    "pack:offline": "pnpm pack"
  },
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/core.js",
    "./browser-controller": "./src/browser-controller.js",
    "./client": "./src/client.js",
    "./nacos-browser.html": "./src/nacos-browser.html",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "files": ["src", "cordis.patch.yml", "README.md", "OFFLINE-INSTALL.zh.md"],
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-invariants": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.2"
  },
  "keywords": ["dsh", "nacos", "nacos-ai", "agentspec", "skill"]
}
